{
	admin off
	email {$ACME_EMAIL}
	log {
		output stdout
		format json
	}
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:8080
}

{$PORTAL_DOMAIN} {
	encode zstd gzip

	handle /metrics {
		respond "not found" 404
	}

	handle /api* {
		reverse_proxy {
			dynamic a api 8000 {
				refresh 5s
			}
			lb_policy round_robin
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
			max_fails 2
		}
	}

	handle /admin* {
		reverse_proxy {
			dynamic a api 8000 {
				refresh 5s
			}
			lb_policy round_robin
			fail_duration 10s
			max_fails 2
		}
	}

	handle /health* {
		reverse_proxy {
			dynamic a api 8000 {
				refresh 5s
			}
			lb_policy round_robin
			fail_duration 10s
			max_fails 2
		}
	}

	handle /static/* {
		reverse_proxy {
			dynamic a api 8000 {
				refresh 5s
			}
		}
	}

	reverse_proxy portal:8080
}
