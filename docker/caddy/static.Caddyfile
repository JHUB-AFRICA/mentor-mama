{
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	@health path /health/live
	handle @health {
		respond "ok" 200
	}

	@metrics path /metrics
	handle @metrics {
		respond "not found" 404
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server
}
