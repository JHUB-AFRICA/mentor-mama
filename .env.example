# PostgreSQL (used by docker-compose.dev.yml and backend settings)
POSTGRES_DB=mentormama
POSTGRES_USER=mentormama
POSTGRES_PASSWORD=mentormama
POSTGRES_PORT=5433
DATABASE_URL=postgres://mentormama:mentormama@localhost:5433/mentormama

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api

# Transactional email. Keep the token out of git and deployment logs.
# Local development uses Django's console backend; email is printed by the
# worker. Enable Mailtrap only in a non-local environment with provider creds.
USE_MAILTRAP=false
EXPORT_STORAGE_BACKEND=local
# Required only for production S3-compatible export storage.
EXPORT_STORAGE_BUCKET=
EXPORT_STORAGE_ENDPOINT=
EXPORT_STORAGE_REGION=
MAILTRAP_API_TOKEN=
# Set for development/QA Sandbox; leave empty for Mailtrap production API.
MAILTRAP_SANDBOX_ID=
MAILTRAP_WEBHOOK_SECRET=
DEFAULT_FROM_EMAIL=accounts@localhost
FRONTEND_BASE_URL=http://localhost:5173
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0
USE_REDIS=true
