# PostgreSQL (used by docker-compose.dev.yml and backend settings)
POSTGRES_DB=mentormama
POSTGRES_USER=mentormama
POSTGRES_PASSWORD=mentormama
POSTGRES_PORT=5432
DATABASE_URL=postgres://mentormama:mentormama@localhost:5432/mentormama

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
