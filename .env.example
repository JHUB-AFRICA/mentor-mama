# PostgreSQL (used by docker-compose.dev.yml and backend settings)
POSTGRES_DB=mentormama
POSTGRES_USER=mentormama
POSTGRES_PASSWORD=mentormama
POSTGRES_PORT=5433
DATABASE_URL=postgres://mentormama:mentormama@localhost:5433/mentormama

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api

# Transactional email. Production sends through Resend from the verified domain sinapstechnology.tech.
# console = print messages to the API/worker log (default for local work). resend = real delivery.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Svix signing secret of the Resend webhook ("whsec_..."). Without it the delivery-callback endpoint stays closed.
RESEND_SIGNING_SECRET=
DEFAULT_FROM_EMAIL=MentorMAMA <mentormama@sinapstechnology.tech>
# Mailtrap is only for a QA sandbox: EMAIL_PROVIDER=mailtrap plus the three values below.
USE_MAILTRAP=false
MAILTRAP_API_TOKEN=
MAILTRAP_SANDBOX_ID=
EXPORT_STORAGE_BACKEND=local
# Required only for production S3-compatible export storage.
EXPORT_STORAGE_BUCKET=
EXPORT_STORAGE_ENDPOINT=
EXPORT_STORAGE_REGION=
# Authenticator codes: accept this many 30-second steps either side of now (1 = previous, current, next).
MFA_TOTP_TOLERANCE=1
FRONTEND_BASE_URL=http://localhost:5173
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0
USE_REDIS=true

# AI (OpenAI for the MVP). Off by default; the key stays server-side only.
# After setting these run: docker compose -f docker-compose.dev.yml up -d api
# then verify with: docker exec mentormama-api python manage.py ai_smoke_test
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-4o-mini
