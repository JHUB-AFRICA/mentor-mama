# Values for the Render env group `mentormama-secrets` (Dashboard > Env Groups > mentormama-secrets > Add from .env).
# This file is a template and is safe to commit: it holds no real values.
#
# To fill it in: copy it to `.env.render.local` (git-ignored), put real values after the "=", and paste the whole
# file into "Add from .env". Lines you leave empty are skipped.
#
# The non-secret settings (domain, sender, Django mode, MFA tolerance, ...) are already in render.yaml under the
# group `mentormama-config`; do not repeat them here.

# ---- Required: the services will not start without these two --------------------------------------------------
# Django's signing key. Invitation and reset links are signed with it, so the API, worker and scheduler must all
# share this one value. Generate: openssl rand -hex 32
SECRET_KEY=

# Resend > API keys > Create (permission: Sending access, domain: sinapstechnology.tech). Starts with re_
RESEND_API_KEY=

# ---- Platform administrator (created on deploy, no invitation email) -------------------------------------------
# Initial password for PLATFORM_ADMIN_EMAIL (set in render.yaml). At least 12 characters, not a common password.
# You are asked to replace it at the first sign-in at /platform. Changing this value later has no effect on an
# account that already exists.
PLATFORM_ADMIN_INITIAL_PASSWORD=

# ---- Required: Cloudflare R2 for uploads and exports ------------------------------------------------------------
# Every upload (documents, covers, lesson images, logos) and every export (PDF, Excel, CSV) is kept in one PRIVATE
# R2 bucket: uploads under private/, exports under exports/. Nothing is public; the API serves files to signed-in
# people. Cloudflare dashboard > R2 > Manage API tokens > Create token: "Object Read & Write", limited to the bucket.
# (The key names below say AWS because R2 is used through its S3-compatible API; the values are R2's.)
# R2 bucket name, e.g. mentor-mama
EXPORT_STORAGE_BUCKET=
# The account endpoint only, with no /bucket at the end: https://<account-id>.r2.cloudflarestorage.com
EXPORT_STORAGE_ENDPOINT=
# Always "auto" for R2
EXPORT_STORAGE_REGION=auto
# The R2 token's "Access Key ID"
AWS_ACCESS_KEY_ID=
# The R2 token's "Secret Access Key"
AWS_SECRET_ACCESS_KEY=

# ---- Add after the first deploy --------------------------------------------------------------------------------
# Resend > Webhooks > Add endpoint https://<your-api-host>/anymail/resend/tracking/ , then copy its signing secret
# (starts with whsec_). Until this is set, the delivery-callback endpoint stays closed and email still sends.
RESEND_SIGNING_SECRET=

# ---- Optional ---------------------------------------------------------------------------------------------------
# Only used if you also set AI_ENABLED=true (it is false in render.yaml).
AI_API_KEY=

# Public website address (the mentormama-website service), used for the progress link in enquiry emails.
WEBSITE_BASE_URL=https://mentormama-website.onrender.com
