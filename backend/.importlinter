# Module boundary contracts (MA-01 .. MA-11). Run: lint-imports
#
# `core` is the platform layer and is public in full (audit, outbox, errors,
# idempotency, http). Every domain module below exposes only api.py and
# events.py; its internals are private to it.
[importlinter]
root_packages =
    apps
include_external_packages = True

[importlinter:contract:layers]
name = Module layers point downward only
type = layers
layers =
    apps.analytics | apps.notifications
    apps.induction | apps.mentorship | apps.assessments | apps.safeguarding
    apps.placements
    apps.institutions | apps.facilities | apps.learning | apps.content
    apps.identity
    apps.core

[importlinter:contract:private-institutions]
name = institutions internals are private to institutions
type = forbidden
source_modules =
    apps.facilities
    apps.learning
    apps.content
    apps.placements
    apps.induction
    apps.mentorship
    apps.assessments
    apps.safeguarding
    apps.analytics
    apps.notifications
forbidden_modules =
    apps.institutions.models
    apps.institutions.services
    apps.institutions.state_machine
    apps.institutions.selectors
    apps.institutions.blockers
    apps.institutions.views
# Public surface: api.py, events.py, and ports.py (a port exists to be
# implemented by a higher layer, so it must be importable — see ADR 0002).
# api.py may use its own internals; only direct reaches across the boundary count.
allow_indirect_imports = True

