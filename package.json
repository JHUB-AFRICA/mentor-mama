{
  "name": "mentor-mama",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @mentormama/web dev",
    "dev:portal": "pnpm --filter @mentormama/portal dev",
    "dev:backend": "cd backend && python manage.py runserver",
    "dev:stack": "docker compose -f docker-compose.dev.yml up",
    "dev:stack:rebuild": "docker compose -f docker-compose.dev.yml up --build",
    "dev:full": "docker compose -f docker-compose.dev.yml --profile full up --build --force-recreate",
    "dev:worker": "cd backend && celery -A config.celery worker --loglevel=INFO --concurrency=1",
    "dev:beat": "cd backend && celery -A config.celery beat --loglevel=INFO",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@mentormama/eslint-config": "workspace:*",
    "@mentormama/prettier-config": "workspace:*",
    "@mentormama/tsconfig-base": "workspace:*",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
