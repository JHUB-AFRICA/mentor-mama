{
  "name": "mentor-mama",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @mentormama/web dev",
    "dev:portal": "pnpm --filter @mentormama/portal dev",
    "dev:backend": "cd backend && python manage.py runserver",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@mentormama/eslint-config": "workspace:*",
    "@mentormama/prettier-config": "workspace:*",
    "@mentormama/tsconfig-base": "workspace:*",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.9.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
