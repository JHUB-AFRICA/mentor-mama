# Copy to .env.production on the VPS, set mode 0600, and replace every placeholder.
# Generate secrets with: openssl rand -hex 32
PUBLIC_DOMAIN=www.example.org
PORTAL_DOMAIN=app.example.org
ACME_EMAIL=ops@example.org

SECRET_KEY=replace-with-64-or-more-hex-characters
POSTGRES_DB=mentormama
POSTGRES_USER=mentormama
POSTGRES_PASSWORD=replace-with-64-hex-characters
REDIS_CACHE_PASSWORD=replace-with-64-hex-characters
REDIS_BROKER_PASSWORD=replace-with-64-hex-characters
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-64-hex-characters
# Email goes out through Resend from the verified domain sinapstechnology.tech (Resend Forge enabled).
DEFAULT_FROM_EMAIL=MentorMAMA <mentormama@sinapstechnology.tech>
RESEND_API_KEY=re_replace_with_your_resend_api_key
# Resend > Webhooks > endpoint https://PORTAL_DOMAIN/anymail/resend/tracking/ > Signing secret ("whsec_...").
# Leave empty to keep the delivery-callback endpoint closed.
RESEND_SIGNING_SECRET=

# Optional. Events are scrubbed in-process before transmission.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
RELEASE_VERSION=replace-with-image-tag-or-git-sha

POSTGRES_MAX_CONNECTIONS=100
REDIS_CACHE_MAXMEMORY=256mb
REDIS_BROKER_MAXMEMORY=256mb
CELERY_CONCURRENCY=2
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

# Optional AI learning explanations (OpenAI for the MVP). Keep this key server-side; never add it to portal build variables.
# To move to a self-hosted OpenAI-compatible server later, change only the base URL, model, and key.
AI_ENABLED=false
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=500

# Public website address, used for the progress link in enquiry emails (never localhost in production).
WEBSITE_BASE_URL=https://www.example.org
