# Copy to .env.production on the VPS, set mode 0600, and replace every placeholder.
# Generate secrets with: openssl rand -hex 32
PUBLIC_DOMAIN=www.example.org
PORTAL_DOMAIN=app.example.org
ACME_EMAIL=ops@example.org

SECRET_KEY=replace-with-64-or-more-hex-characters
POSTGRES_DB=mentormama
POSTGRES_USER=mentormama
POSTGRES_PASSWORD=replace-with-64-hex-characters
REDIS_CACHE_PASSWORD=replace-with-64-hex-characters
REDIS_BROKER_PASSWORD=replace-with-64-hex-characters
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-64-hex-characters
DEFAULT_FROM_EMAIL=accounts@example.org

# Optional. Events are scrubbed in-process before transmission.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
RELEASE_VERSION=replace-with-image-tag-or-git-sha

POSTGRES_MAX_CONNECTIONS=100
REDIS_CACHE_MAXMEMORY=256mb
REDIS_BROKER_MAXMEMORY=256mb
CELERY_CONCURRENCY=2
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
